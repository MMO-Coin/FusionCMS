# Copy this file to docker/.env. These values configure Compose, not the CMS.
FUSION_BIND_ADDRESS=127.0.0.1
FUSION_HTTP_PORT=8080
TZ=UTC

# Used only with compose.database.yaml. Enter the same credentials in the installer.
FUSION_DB_NAME=fusioncms
FUSION_DB_USER=fusioncms
# Use separate, long random passwords. Single quotes preserve literal $ and # characters.
FUSION_DB_PASSWORD=''
FUSION_DB_ROOT_PASSWORD=''
